# DNS Guardian — ignore build artifacts, local config, and secrets.

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
*.log

# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/key.properties
android/**/release/
*.jks
*.keystore
captures/

# Secrets / signing
**/signing.properties
**/*.p12
**/*.pem

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Local docs output (optional)
docs/local/
